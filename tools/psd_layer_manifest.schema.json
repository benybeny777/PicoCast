{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PicoCast PSDレイヤーmanifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "canvas",
    "pixel_tolerance",
    "layers",
    "variants",
    "unsupported_composition",
    "expression_overlay_policy",
    "coverage",
    "qualified"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes",
        "psd_tools_version",
        "depth",
        "color_mode"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "psd_tools_version": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "enum": [
            8,
            16,
            32
          ]
        },
        "color_mode": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pixel_tolerance": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "parent_id",
          "order",
          "name",
          "kind",
          "visible",
          "opacity",
          "blend_mode",
          "clipping",
          "bbox",
          "is_group",
          "image"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+(/[0-9]+)*$"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "visible": {
            "type": "boolean"
          },
          "opacity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "blend_mode": {
            "type": "string"
          },
          "clipping": {
            "type": "boolean"
          },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer"
            }
          },
          "is_group": {
            "type": "boolean"
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(layers|variants)/[0-9]{6}\\.png$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "visibility",
          "image",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(layers|variants)/[0-9]{6}\\.png$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_abs_channel_diff",
              "mismatched_pixels",
              "qualified"
            ],
            "properties": {
              "max_abs_channel_diff": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "mismatched_pixels": {
                "type": "integer",
                "minimum": 0
              },
              "qualified": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "unsupported_composition": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer_id",
          "reason"
        ],
        "properties": {
          "layer_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "expression_overlay_policy": {
      "const": "disable_mouth_and_blink_on_expression_png"
    },
    "coverage": {
      "type": "object"
    },
    "qualified": {
      "type": "boolean"
    }
  }
}
